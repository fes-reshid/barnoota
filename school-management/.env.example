# Firebase project configuration.
# Copy this file to .env.local and fill in your Firebase project's values
# (Project settings > General > Your apps > SDK setup and configuration).
# When these are absent the app automatically runs in local "demo mode",
# using an in-browser data store instead of Firebase so the UI is always
# usable out of the box.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: your Telegram bot's @username (no @), e.g. BarnootaCampusBot.
# Lets parents tap a "Connect Telegram" button on their dashboard instead
# of typing it manually. See the Telegram section of the README for how to
# create a bot. Leave unset to hide that button — WhatsApp/email still work
# without it.
VITE_TELEGRAM_BOT_USERNAME=
