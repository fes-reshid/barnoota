# Firebase project configuration.
# Copy this file to .env.local and fill in your Firebase project's values
# (Project settings > General > Your apps > SDK setup and configuration).
# When these are absent the app automatically runs in local "demo mode",
# using an in-browser data store instead of Firebase so the UI is always
# usable out of the box.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
