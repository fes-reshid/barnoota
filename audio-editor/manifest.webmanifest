{
  "id": "./",
  "name": "Audio Editor — Diin Islaam",
  "short_name": "Audio Editor",
  "description": "Edit, record, clean up and split audio in your browser — trim, join, noise reduction, multitrack, MP3. Works offline; nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#faf3e0",
  "theme_color": "#2e6b58",
  "categories": ["music", "education", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "audio/*": [".mp3", ".wav", ".m4a", ".ogg", ".flac", ".aac", ".webm"] } }
  ]
}
