{
  "name": "noor-shield-pc",
  "version": "0.1.0",
  "private": true,
  "description": "Noor Shield for Windows — device-wide adult-content filter with Islamic reminders and a parent-controlled lock",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.barnoota.noorshield",
    "productName": "Noor Shield",
    "files": [
      "src/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      "resources/blocklist_domains.txt"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
