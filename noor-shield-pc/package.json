{
  "name": "noor-shield-pc",
  "version": "0.7.2",
  "private": true,
  "description": "Noor Shield for Windows — device-wide adult-content filter with Islamic reminders, an always-on protection service, and a parent-controlled lock",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "service": "node service/filterService.js",
    "service:install": "node -e \"require('./service/install').install().then(()=>console.log('installed')).catch(e=>{console.error(e);process.exit(1)})\"",
    "service:uninstall": "node -e \"require('./service/uninstall').uninstall().then(()=>console.log('uninstalled')).catch(e=>{console.error(e);process.exit(1)})\"",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "node-windows": "1.0.0-beta.8",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.barnoota.noorshield",
    "productName": "Noor Shield",
    "files": [
      "src/**/*",
      "service/**/*",
      "resources/**/*"
    ],
    "asar": false,
    "publish": null,
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
