{
  "name": "easy-invoice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"vitest run --config vitest.emulator.config.ts\"",
    "smoke:golden-path": "node scripts/golden-path.smoke.mjs",
    "smoke:pdf-multipage": "node scripts/pdf-multipage.smoke.mjs",
    "smoke:quote-flow": "node scripts/quote-flow.smoke.mjs",
    "smoke:demo-mode": "node scripts/demo-mode.smoke.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
