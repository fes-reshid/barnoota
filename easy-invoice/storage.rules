rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Business logos. Publicly readable (they're printed on PDFs/emails
    // that go to customers outside the app), but only a member of that
    // business can upload one, checked against the Firestore membership
    // map via a cross-service rule.
    match /businesses/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.members;
    }
  }
}
